{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/app/welcome.jsx",
    "src/app/_layout.jsx",
    "src/app/login.jsx",
    "src/app/about.tsx",
    "src/app/auth.tsx"
  ]
}
