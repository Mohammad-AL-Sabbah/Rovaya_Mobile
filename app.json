{
  "expo": {
    "name": "Rovaya",
    "slug": "Rovaya_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rovayamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يحتاج تطبيق Rovaya إلى موقعك الحالي لعرض الخريطة ورسم المسار بين الأماكن السياحية والمطاعم القريبة منك.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يحتاج تطبيق Rovaya إلى موقعك لتوفير تجربة ملاحة دقيقة أثناء التنقل بين المدن الفلسطينية.",
        "NSLocationAlwaysUsageDescription": "يحتاج تطبيق Rovaya إلى موقعك لتوفير تجربة ملاحة دقيقة."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohmmadsabbah.Rovaya_Mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBkRA7UyRPDBbxc7rne60Y4QhBcVkgt388"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-build-properties",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyBkRA7UyRPDBbxc7rne60Y4QhBcVkgt388"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج تطبيق Rovaya إلى موقعك لعرض الخريطة ورسم المسار بين الأماكن السياحية."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "319e7dfb-8e89-4e67-a3a0-85eca8f7755d"
      },
        "googleMapsApiKey": "AIzaSyBkRA7UyRPDBbxc7rne60Y4QhBcVkgt388"
    }
  }
}